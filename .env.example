ACVP_VERSION=0.1.0
ACVP_BIND_ADDRESS=127.0.0.1
ACVP_HTTP_PORT=8080

POSTGRES_DB=acvp
POSTGRES_USER=nccu
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt

ACVP_GENVAL_TIMEOUT_SECONDS=300
ACVP_ACCESS_TOKEN_TTL_SECONDS=1800

# Optional build provenance. scripts/docker/build.sh fills these automatically.
ACVP_VCS_REF=unknown
ACVP_BUILD_DATE=unknown
